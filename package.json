{
  "name": "swimming-pool-design",
  "version": "0.9.7",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "prepare": "npm run build:content",
    "predev": "npm run build:content",
    "dev": "vite",
    "dev:lan": "npm run dev -- --host",
    "build:content": "node tools/build/build-content.mjs",
    "build:drawings": "node tools/build/build-drawings.mjs && node tools/build/render-drawing-png.mjs drawings/current/DRAW-L1-PLAN.svg drawings/current/DRAW-L2-PLAN.svg drawings/current/DRAW-L3-PLAN.svg drawings/current/DRAW-LONGITUDINAL-SECTION.svg",
    "build:analysis": "node tools/analysis/solar-optimize.mjs",
    "build:copy": "node tools/build/build-copy.mjs",
    "build:textures": "node tools/build/build-textures.mjs",
    "check:docs": "node tools/check/check-docs.mjs",
    "check:model": "node tools/check/check-model.mjs",
    "check:assets": "node tools/check/check-assets.mjs",
    "pretest": "npm run build:content",
    "test": "node --test \"tests/unit/**/*.test.mjs\"",
    "pretypecheck": "npm run build:content",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:e2e": "node tests/e2e/web.e2e.mjs && node tests/e2e/3d-viewer.e2e.mjs",
    "capture:viewer-quality": "npm run build && node tools/capture/capture-viewer-quality.mjs",
    "clean:dist": "node tools/build/clean-dist.mjs",
    "build": "npm run build:content && npm run check:docs && npm run check:model && npm run check:assets && npm test && npm run typecheck && npm run clean:dist && vite build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/three": "^0.185.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "ktx2-encoder": "0.6.0",
    "playwright-core": "^1.61.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
